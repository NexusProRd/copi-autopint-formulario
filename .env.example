# URL del despliegue web de Google Apps Script (termina en /exec)
GAS_WEB_APP_URL=
# Secreto de API guardado en Script Properties del GAS. NUNCA NEXT_PUBLIC_
GAS_API_SECRET=
# ID de cuestionario entregado por GAS, si aplica
GAS_QUESTIONNAIRE_ID=
# Número WhatsApp con código de país, sin signos
NEXT_PUBLIC_NEXUS_WHATSAPP=
